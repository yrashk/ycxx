@PACKAGE_INIT@

set_and_check(ycxx_RESOURCE_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/ycxx/resources")
set_and_check(ycxx_TARGET_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/ycxx/target/include")
set(ycxx_STDLIB "@YCXXC_STDLIB@")
set(ycxx_DARWIN_RUNTIME_ARCHIVES "")
set(ycxx_DARWIN_RUNTIME_UNDEFINED "@ycxxc_darwin_undefined@")
foreach(_ycxx_archive IN ITEMS @ycxxc_darwin_archive_names@)
  set_and_check(_ycxx_archive_path
    "@PACKAGE_CMAKE_INSTALL_DATADIR@/ycxx/target/arm64-apple-darwin/lib/${_ycxx_archive}")
  list(APPEND ycxx_DARWIN_RUNTIME_ARCHIVES "${_ycxx_archive_path}")
endforeach()
unset(_ycxx_archive)
unset(_ycxx_archive_path)

include(CMakeFindDependencyMacro)
if(ycxx_STDLIB STREQUAL "system")
  find_dependency(libycxxExecution CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../libycxxExecution" NO_DEFAULT_PATH)
  if(NOT TARGET ycxx::system_std)
    include("${CMAKE_CURRENT_LIST_DIR}/ycxx-system-stdlib.cmake")
    ycxxc_system_std_module()
    add_library(ycxx::system_std ALIAS ycxxc_system_std)
  endif()
  set(_ycxx_standard_module ycxx::system_std)
else()
  find_dependency(libycxx CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../libycxx" NO_DEFAULT_PATH)
  if("@YCXXC_BUILD_SHARED_LIBS@")
    set(_ycxx_standard_module ycxx::shared_modules)
  else()
    set(_ycxx_standard_module ycxx::modules)
  endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ycxxTargets.cmake")
# CMake's imported-module synthesis needs a direct dependency on the std provider.
# Normal C++ link requirements still come from the exported options target.
foreach(_ycxx_target IN ITEMS @ycxxc_exported_components@)
  set_property(TARGET "${_ycxx_target}" APPEND PROPERTY
    IMPORTED_CXX_MODULES_LINK_LIBRARIES "${_ycxx_standard_module}")
  set_property(TARGET "${_ycxx_target}" APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES "${_ycxx_standard_module}")
endforeach()
unset(_ycxx_standard_module)
unset(_ycxx_target)
if(TARGET ycxx::preprocessor)
  if(NOT TARGET _ycxx_pp_sdk_paths)
    string(REPLACE "\\" "\\\\" _ycxx_pp_resource_lit "${ycxx_RESOURCE_DIR}")
    string(REPLACE "\"" "\\\"" _ycxx_pp_resource_lit "${_ycxx_pp_resource_lit}")
    string(REPLACE "\\" "\\\\" _ycxx_pp_target_lit "${ycxx_TARGET_INCLUDE_DIR}")
    string(REPLACE "\"" "\\\"" _ycxx_pp_target_lit "${_ycxx_pp_target_lit}")
    set(_ycxx_pp_paths_src "${CMAKE_BINARY_DIR}/_ycxx_sdk/pp_sdk_paths.cpp")
    string(CONCAT _ycxx_pp_paths_content
      "extern \"C\" void ycxx_pp_register_sdk_paths(const char*, const char*) noexcept;\n"
      "namespace {\n"
      "[[gnu::constructor, gnu::used]] void ycxx_pp_register_installed_sdk_paths() noexcept {\n"
      "  ycxx_pp_register_sdk_paths(\"${_ycxx_pp_resource_lit}\", \"${_ycxx_pp_target_lit}\");\n"
      "}\n"
      "}\n")
    set(_ycxx_pp_write TRUE)
    if(EXISTS "${_ycxx_pp_paths_src}")
      file(READ "${_ycxx_pp_paths_src}" _ycxx_pp_existing)
      if(_ycxx_pp_existing STREQUAL _ycxx_pp_paths_content)
        set(_ycxx_pp_write FALSE)
      endif()
      unset(_ycxx_pp_existing)
    endif()
    if(_ycxx_pp_write)
      file(WRITE "${_ycxx_pp_paths_src}" "${_ycxx_pp_paths_content}")
    endif()
    add_library(_ycxx_pp_sdk_paths OBJECT "${_ycxx_pp_paths_src}")
    set_target_properties(_ycxx_pp_sdk_paths PROPERTIES
      CXX_SCAN_FOR_MODULES OFF
      CXX_EXTENSIONS OFF
      POSITION_INDEPENDENT_CODE ON)
    unset(_ycxx_pp_resource_lit)
    unset(_ycxx_pp_target_lit)
    unset(_ycxx_pp_paths_src)
    unset(_ycxx_pp_paths_content)
    unset(_ycxx_pp_write)
  endif()
  get_target_property(_ycxx_pp_iface_libs ycxx::preprocessor INTERFACE_LINK_LIBRARIES)
  if(NOT _ycxx_pp_iface_libs OR NOT "_ycxx_pp_sdk_paths" IN_LIST _ycxx_pp_iface_libs)
    set_property(TARGET ycxx::preprocessor APPEND PROPERTY INTERFACE_LINK_LIBRARIES _ycxx_pp_sdk_paths)
  endif()
  unset(_ycxx_pp_iface_libs)
endif()
foreach(component IN LISTS ycxx_FIND_COMPONENTS)
  if(TARGET "ycxx::${component}")
    set("ycxx_${component}_FOUND" TRUE)
  else()
    set("ycxx_${component}_FOUND" FALSE)
  endif()
endforeach()
check_required_components(ycxx)
