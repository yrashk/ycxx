# Build the GCC installation's std module with the same configuration as ycxx's modules.
function(ycxxc_system_std_module)
  execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-file-name=libstdc++.modules.json
    OUTPUT_VARIABLE manifest OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT IS_ABSOLUTE "${manifest}" OR NOT EXISTS "${manifest}")
    message(FATAL_ERROR "The configured GCC installation does not provide a libstdc++ module manifest")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
  file(READ "${manifest}" metadata)
  cmake_path(GET manifest PARENT_PATH manifest_directory)
  string(JSON module_count LENGTH "${metadata}" modules)
  if(module_count EQUAL 0)
    message(FATAL_ERROR "The configured libstdc++ module manifest is empty")
  endif()
  math(EXPR last_module "${module_count} - 1")
  set(interface "")
  foreach(index RANGE ${last_module})
    string(JSON module_name GET "${metadata}" modules "${index}" logical-name)
    if(module_name STREQUAL "std")
      string(JSON interface GET "${metadata}" modules "${index}" source-path)
      cmake_path(ABSOLUTE_PATH interface BASE_DIRECTORY "${manifest_directory}" NORMALIZE)
      break()
    endif()
  endforeach()
  if(NOT EXISTS "${interface}")
    message(FATAL_ERROR "The configured libstdc++ module manifest does not name a std interface")
  endif()
  cmake_path(GET interface PARENT_PATH interface_directory)
  add_library(ycxxc_system_std STATIC)
  set_target_properties(ycxxc_system_std PROPERTIES POSITION_INDEPENDENT_CODE ON CXX_SCAN_FOR_MODULES ON CXX_EXTENSIONS OFF)
  target_sources(ycxxc_system_std PUBLIC FILE_SET CXX_MODULES
    BASE_DIRS "${interface_directory}" FILES "${interface}")
  target_compile_features(ycxxc_system_std PUBLIC cxx_std_26)
  target_compile_options(ycxxc_system_std PRIVATE -freflection -fcontracts)
endfunction()
