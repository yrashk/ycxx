set(automatic "${CMAKE_CURRENT_BINARY_DIR}/elf-pipeline-main")
set(explicit "${CMAKE_CURRENT_BINARY_DIR}/elf-pipeline-start")
execute_process(COMMAND "${PIPELINE}" "${automatic}" "${explicit}" COMMAND_ERROR_IS_FATAL ANY)

execute_process(COMMAND "${automatic}" " " RESULT_VARIABLE status TIMEOUT 5)
if(NOT status STREQUAL "42")
  message(FATAL_ERROR "Expected stack alignment (8) + argc (2) + argv[1][0] (32) = 42, got ${status}")
endif()
execute_process(COMMAND "${automatic}" "A" "extra" RESULT_VARIABLE status TIMEOUT 5)
if(NOT status STREQUAL "76")
  message(FATAL_ERROR "Expected stack alignment (8) + argc (3) + argv[1][0] (65) = 76, got ${status}")
endif()
execute_process(COMMAND "${explicit}" RESULT_VARIABLE status TIMEOUT 5)
if(NOT status STREQUAL "23")
  message(FATAL_ERROR "Expected the caller's _start to exit 23, got ${status}")
endif()
