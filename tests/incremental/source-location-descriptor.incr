// Indenting, inserting a blank line, and renaming the presumed file each change one
// coordinate and add one failed assertion. Restoring the original call site clears them.
--- main.cpp
#include "expected.hpp"
#include "observed.hpp"
static_assert(observe().line() == 701);
static_assert(observe().column() == observed_column);
static_assert(observe().file_name()[0] == 'a');
--- expected.hpp
#if defined(__GNUC__) && !defined(__clang__) && !defined(__ycxx__)
constexpr unsigned observed_column = 39;
#else
constexpr unsigned observed_column = 10;
#endif
--- observed.hpp
#include <source_location>
#line 700 "alpha-source.cpp"
constexpr std::source_location observe() {
  return std::source_location::current();
}
