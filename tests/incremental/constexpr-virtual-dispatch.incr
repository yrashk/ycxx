// ACTION: syntax
--- main.cpp
#include "dial.h"

constexpr int run() {
    Adjusted dial;
    return read(dial);
}

static_assert(run() == 14);
--- dial.h
struct Dial {
    constexpr virtual int value(int sample = 4) const { return sample; }
};

struct Adjusted : public Dial {
    constexpr int value(int sample) const override { return sample + 10; }
};

constexpr int read(const Dial& dial) { return dial.value(); }
