// Found by tools/incr-fuzz on #947: a namespace that loses its closing brace reports it, so a
// block's content for group reuse holds whether it is closed; its other members stay as they were.
// ACTION: syntax
--- main.cpp
enum E { item };
E value();
namespace N {
    struct Result {};
    typedef Result (*Fn)();
    struct Wrap { Wrap(E); };
    int operator,(Wrap, Fn) = delete;
}
N::Fn use(N::Fn f) { return (value(), f); }
