use plugin("rules/package") as tools

cpp.host_executable "scanner" {
    sources = ["scanner.cc"]
}

generate "scan_inventory" {
    tool = "/bin/sh"
    args = [input("script"), input("scanner"), output("list")]
    inputs = { script = "scan-inventory.sh" scanner = artifact("scanner", "executable") }
    outputs = { list = "inventory.txt" }
}

generate "inventory" {
    tool = "/bin/cp"
    args = [input("list"), output("list")]
    inputs = { list = artifact("scan_inventory", "list") }
    outputs = { list = "inventory.txt" }
}

tools.header "config" {
    plan_inputs = { inventory = artifact("inventory", "list") }
}

cpp.executable "app" {
    sources = ["main.cc"]
    generated_headers = [artifact("config", "header")]
}
