use plugin("rules/package") as shaders

shaders.bundle "scene" {
    inventory = "shaders/inventory.txt"
    reads = ["shaders/inventory.txt"]
    compiler = "/usr/bin/glslc"
    python = "/usr/bin/python3"
}

generate "release_note" {
    tool = "/bin/sh"
    args = ["-c", "printf '%s\\n' \"$1\" > \"$2\"", "release-note",
            "Scene bundle entries contain a shader name and hexadecimal SPIR-V.", output("note")]
    outputs = { note = "release-note.txt" }
}

cpp.executable "app" {
    sources = ["main.cc"]
    runtime_assets = [artifact("scene", "bundle"), artifact("release_note", "note")]
}
