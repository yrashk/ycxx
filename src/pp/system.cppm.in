// The system include directories of this build (configured by CMake): libycxx's headers, the
// ones libycxx's build generated, ycxx's resource headers for Linux, and the C library's
// headers in the SDK (`$SDKROOT` overrides the SDK the build used).
export module ycxx.pp:system;

import std;
import ycxx.ast.target;

export namespace ycxx::pp {

// ycxx's version, for `__ycxx_major__` and its siblings.
inline constexpr int version_major = @PROJECT_VERSION_MAJOR@;
inline constexpr int version_minor = @PROJECT_VERSION_MINOR@;
inline constexpr int version_patch = @PROJECT_VERSION_PATCH@;

std::vector<std::string> system_dirs(const ast::Target& target = ast::aarch64_darwin) {
  std::vector<std::string> dirs{"@YCXX_LIBYCXX_INCLUDE@", "@YCXX_LIBYCXX_GENERATED_INCLUDE@"};
  if (target.triple == ast::x86_64_linux.triple) dirs.push_back("@YCXX_LINUX_RESOURCE_INCLUDE@");
  std::string sdk = target.triple == ast::aarch64_darwin.triple ? "@CMAKE_OSX_SYSROOT@" : "";
  if (const char* env = std::getenv("SDKROOT"); env != nullptr && *env != '\0') sdk = env;
  std::string include = sdk + "/usr/include";
  if (!target.multiarch.empty()) dirs.push_back(std::format("{}/{}", include, target.multiarch));
  dirs.push_back(std::move(include));
  return dirs;
}

}  // namespace ycxx::pp
