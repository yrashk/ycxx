// The Unicode the lexer needs: UTF-8, the identifier properties of [lex.name], the Normalization
// Form C check of [lex.name]/1, and character names for [lex.universal.char]/3. The data is
// generated by tools/unicode/gen-tables into :unicode_tables and unicode_names.txt.
export module ycxx.lex:unicode;

import std;
import :unicode_tables;

namespace ycxx::lex::unicode {

// The character names and aliases, one `NAME;HEX` line each, sorted by name.
constexpr unsigned char names_blob[] = {
#embed "unicode_names.txt"
};

constexpr bool in(std::span<const CodeRange> table, char32_t c) {
  auto it = std::ranges::upper_bound(table, c, {}, &CodeRange::first);
  return it != table.begin() && c <= std::prev(it)->last;
}

// Hangul syllables (The Unicode Standard, §3.12).
constexpr char32_t s_base = 0xAC00, l_base = 0x1100, v_base = 0x1161, t_base = 0x11A7;
constexpr char32_t l_count = 19, v_count = 21, t_count = 28, n_count = v_count * t_count, s_count = l_count * n_count;

constexpr std::array<std::string_view, l_count> jamo_l{"G", "GG", "N", "D", "DD", "R", "M", "B", "BB", "S",
                                                       "SS", "", "J", "JJ", "C", "K", "T", "P", "H"};
constexpr std::array<std::string_view, v_count> jamo_v{"A", "AE", "YA", "YAE", "EO", "E", "YEO", "YE", "O", "WA", "WAE",
                                                       "OE", "YO", "U", "WEO", "WE", "WI", "YU", "EU", "YI", "I"};
constexpr std::array<std::string_view, t_count> jamo_t{"", "G", "GG", "GS", "N", "NJ", "NH", "D", "L", "LG",
                                                       "LM", "LB", "LS", "LT", "LP", "LH", "M", "B", "BS", "S",
                                                       "SS", "NG", "J", "C", "K", "T", "P", "H"};

// Matches the longest jamo short name of `table` at the start of `s` (the empty name included).
template <std::size_t N>
constexpr std::optional<char32_t> match_jamo(std::string_view& s, const std::array<std::string_view, N>& table) {
  std::optional<char32_t> best;
  std::size_t best_len = 0;
  for (char32_t i = 0; i < N; ++i) {
    if (s.starts_with(table[i]) && (!best || table[i].size() > best_len)) {
      best = i;
      best_len = table[i].size();
    }
  }
  if (best) s.remove_prefix(best_len);
  return best;
}

std::optional<char32_t> hangul_syllable(std::string_view s) {
  // Short names are ambiguous only in principle; try every L, then the longest V and T.
  for (char32_t l = 0; l < l_count; ++l) {
    if (!s.starts_with(jamo_l[l])) continue;
    std::string_view rest = s.substr(jamo_l[l].size());
    auto v = match_jamo(rest, jamo_v);
    if (!v) continue;
    // T is optional; an exact match must consume everything.
    for (char32_t t = 0; t < t_count; ++t) {
      if (rest == jamo_t[t]) return s_base + (l * v_count + *v) * t_count + t;
    }
  }
  return std::nullopt;
}

std::optional<char32_t> parse_hex(std::string_view s) {
  if (s.empty() || s.size() > 6) return std::nullopt;
  char32_t v = 0;
  for (char c : s) {
    int d = c >= '0' && c <= '9' ? c - '0' : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
    if (d < 0) return std::nullopt;
    v = v * 16 + char32_t(d);
  }
  return v;
}

std::string_view blob() { return {reinterpret_cast<const char*>(names_blob), sizeof names_blob}; }

constexpr std::uint8_t combining_class(char32_t c) {
  auto it = std::ranges::upper_bound(combining_classes, c, {}, &ClassRange::first);
  if (it == combining_classes.begin() || c > std::prev(it)->last) return 0;
  return std::prev(it)->ccc;
}

void decompose(char32_t c, std::u32string& out) {
  if (c >= s_base && c < s_base + s_count) {
    char32_t s = c - s_base;
    out += l_base + s / n_count;
    out += v_base + (s % n_count) / t_count;
    if (s % t_count != 0) out += t_base + s % t_count;
    return;
  }
  auto it = std::ranges::lower_bound(decompositions, c, {}, &Composition::composite);
  if (it == decompositions.end() || it->composite != c) {
    out += c;
    return;
  }
  decompose(it->first, out);
  if (it->second != 0) decompose(it->second, out);
}

std::optional<char32_t> compose(char32_t a, char32_t b) {
  if (a >= l_base && a < l_base + l_count && b >= v_base && b < v_base + v_count) {
    return s_base + ((a - l_base) * v_count + (b - v_base)) * t_count;
  }
  if (a >= s_base && a < s_base + s_count && (a - s_base) % t_count == 0 && b > t_base && b < t_base + t_count) {
    return a + (b - t_base);
  }
  auto it = std::ranges::lower_bound(compositions, std::pair{a, b}, {},
                                     [](const Composition& x) { return std::pair{x.first, x.second}; });
  if (it != compositions.end() && it->first == a && it->second == b) return it->composite;
  return std::nullopt;
}

// Normalization Form C (UAX #15): canonical decomposition, canonical ordering, composition.
std::u32string nfc(std::u32string_view s) {
  std::u32string d;
  for (char32_t c : s) decompose(c, d);
  // Canonical ordering: a stable sort of each run of non-starters by combining class.
  for (std::size_t i = 0; i < d.size();) {
    if (combining_class(d[i]) == 0) {
      ++i;
      continue;
    }
    std::size_t j = i;
    while (j < d.size() && combining_class(d[j]) != 0) ++j;
    std::ranges::stable_sort(d.begin() + i, d.begin() + j, {}, combining_class);
    i = j;
  }
  // Canonical composition.
  std::u32string out;
  std::optional<std::size_t> starter;
  int last_ccc = -1;  // of the previous character kept after the starter; -1 if none
  for (char32_t c : d) {
    int ccc = combining_class(c);
    if (starter && (last_ccc == -1 || (last_ccc != 0 && last_ccc < ccc))) {
      if (auto k = compose(out[*starter], c)) {
        out[*starter] = *k;
        continue;
      }
    }
    if (ccc == 0) {
      starter = out.size();
      last_ccc = -1;
    } else {
      last_ccc = ccc;
    }
    out += c;
  }
  return out;
}

}  // namespace ycxx::lex::unicode

export namespace ycxx::lex::unicode {

// A decoded UTF-8 sequence: the scalar value and its length in bytes.
struct Decoded {
  char32_t c = 0;
  std::uint8_t length = 0;
};

// Decodes the well-formed UTF-8 sequence at the start of `s`, or nothing (an ill-formed sequence,
// an overlong form, a surrogate, a value past U+10FFFF, or a truncated sequence).
constexpr std::optional<Decoded> decode_utf8(std::string_view s) {
  if (s.empty()) return std::nullopt;
  auto b = [&](std::size_t i) { return static_cast<unsigned char>(s[i]); };
  unsigned char b0 = b(0);
  if (b0 < 0x80) return Decoded{b0, 1};
  std::size_t n = b0 >= 0xF0 ? 4 : b0 >= 0xE0 ? 3 : b0 >= 0xC2 ? 2 : 0;
  if (n == 0 || b0 > 0xF4 || s.size() < n) return std::nullopt;
  char32_t c = b0 & (0x7F >> n);
  for (std::size_t i = 1; i < n; ++i) {
    if ((b(i) & 0xC0) != 0x80) return std::nullopt;
    c = (c << 6) | (b(i) & 0x3F);
  }
  constexpr char32_t min[] = {0, 0, 0x80, 0x800, 0x10000};
  if (c < min[n] || c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF)) return std::nullopt;
  return Decoded{c, static_cast<std::uint8_t>(n)};
}

constexpr bool is_scalar_value(char32_t c) { return c <= 0x10FFFF && !(c >= 0xD800 && c <= 0xDFFF); }

constexpr void append_utf8(std::string& out, char32_t c) {
  if (c < 0x80) {
    out += static_cast<char>(c);
  } else if (c < 0x800) {
    out += static_cast<char>(0xC0 | (c >> 6));
    out += static_cast<char>(0x80 | (c & 0x3F));
  } else if (c < 0x10000) {
    out += static_cast<char>(0xE0 | (c >> 12));
    out += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
    out += static_cast<char>(0x80 | (c & 0x3F));
  } else {
    out += static_cast<char>(0xF0 | (c >> 18));
    out += static_cast<char>(0x80 | ((c >> 12) & 0x3F));
    out += static_cast<char>(0x80 | ((c >> 6) & 0x3F));
    out += static_cast<char>(0x80 | (c & 0x3F));
  }
}

// [lex.name]: nondigit, or XID_Start, or ID_Compat_Math_Start.
constexpr bool is_identifier_start(char32_t c) {
  if (c < 0x80) return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
  return in(identifier_start, c);
}

// [lex.name]: digit, nondigit, or XID_Continue, or ID_Compat_Math_Continue.
constexpr bool is_identifier_continue(char32_t c) {
  if (c < 0x80) return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
  return in(identifier_continue, c);
}

// [lex.name]/1: whether `s` is in Normalization Form C. The quick check (UAX #15) settles almost
// every identifier; a possible composition is settled by normalizing.
bool is_nfc(std::u32string_view s) {
  bool maybe = false;
  std::uint8_t last = 0;
  for (char32_t c : s) {
    if (in(nfc_no, c)) return false;
    std::uint8_t ccc = combining_class(c);
    if (ccc != 0 && last > ccc) return false;
    last = ccc;
    if (in(nfc_maybe, c) || (c >= v_base && c < v_base + v_count) || (c > t_base && c < t_base + t_count)) {
      maybe = true;
    }
  }
  return !maybe || nfc(s) == s;
}

// [lex.universal.char]/3: the character whose name or name alias is exactly `name`.
std::optional<char32_t> lookup_name(std::string_view name) {
  if (name.empty() || name.find('\n') != name.npos || name.find(';') != name.npos) return std::nullopt;
  if (name.starts_with("HANGUL SYLLABLE ")) return hangul_syllable(name.substr(16));
  for (const AlgorithmicName& a : algorithmic_names) {
    if (!name.starts_with(a.prefix)) continue;
    std::string_view hex = name.substr(a.prefix.size());
    // The name has exactly four or five uppercase digits, as the code point is spelled.
    if (hex.size() < 4 || (hex.size() > 4 && hex[0] == '0')) return std::nullopt;
    auto c = parse_hex(hex);
    if (c && in(a.ranges, *c)) return c;
    return std::nullopt;
  }
  // Binary search over the lines of the sorted blob.
  std::string_view b = blob();
  std::size_t lo = 0, hi = b.size();
  while (lo < hi) {
    std::size_t mid = lo + (hi - lo) / 2;
    std::size_t start = b.rfind('\n', mid);
    start = start == b.npos || start < lo ? lo : start + 1;
    std::size_t end = b.find('\n', start);
    std::string_view line = b.substr(start, end - start);
    std::size_t semi = line.find(';');
    std::string_view key = line.substr(0, semi);
    if (key == name) return parse_hex(line.substr(semi + 1));
    if (key < name) lo = end + 1;
    else hi = start;
  }
  return std::nullopt;
}

}  // namespace ycxx::lex::unicode
