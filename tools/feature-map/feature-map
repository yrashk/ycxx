def cmd_check(args):
    groups, feats = load_features()
    bad = []
    for f in feats:
        if f['status'] != 'done' and not f.get('issues'):
            bad.append(f'{f["id"]}: {f["status"]} without an issue')
    parents = clause_tree()
    known = set(parents)
    children = {}
    for c, par in parents.items():
        children.setdefault(par, []).append(c)
    listed = {c.rstrip('*') for f in feats for c in f['clauses']}
    subtrees = {c[:-1] for f in feats for c in f['clauses'] if c.endswith('*')}

    # Every leaf clause is cited by some feature (a heading citing it does not count, or [class]
    # would cover all of [class.*]); a heading is covered when all its subclauses are.
    def covered(c):
        a = c
        while a:
            if a in subtrees:
                return True
            a = parents.get(a, '')
        kids = children.get(c, [])
        if not kids:
            return c in listed or c in NOT_FEATURES
        return all(covered(k) for k in kids)
    for c in parents:
        if not children.get(c) and not covered(c):
            bad.append(f'[{c}] is cited by no feature')
    for c in sorted(listed - known):
        if not re.match(r'(?:support|meta|cmp|numeric|bit|ptr|specialized|utility|atomics)\b', c):
            bad.append(f'[{c}] is cited but is not a clause of the pinned draft')
    probes = {r['feature']: r for r in read_tsv(PROBES)} if args.probes else {}
    if args.probes and not probes:
        bad.append(f'{PROBES.relative_to(REPO)} is missing: run feature-map probe first')
    for f in feats if probes else ():
        p = probes.get(f['id'])
        if not p:
            if f.get('probe'):
                bad.append(f'{f["id"]}: its probe was never run (feature-map probe)')
            continue
        if p['oracle'] == 'none':
            bad.append(f'{f["id"]}: no oracle accepts the probe')
        elif p['ycxx'] == 'pass' and f['status'] == 'missing':
            bad.append(f'{f["id"]}: marked missing, but its probe passes')
        elif p['ycxx'] == 'fail' and f['status'] == 'done':
            bad.append(f'{f["id"]}: marked done, but its probe fails: {p["first_error"]}')
    for b in bad:
        print(b)
    sys.exit(1 if bad else 0)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('command', nargs='?', default='render',
                    choices=['fetch', 'count', 'probe', 'render', 'issue', 'check'])
    ap.add_argument('--corpus', default=str(DEFAULT_CORPUS), help='where the corpus is downloaded')
    ap.add_argument('--ycxx', default=str(REPO / 'build' / 'bin' / 'ycxx'), help='the ycxx to probe')
    ap.add_argument('--only', help='probe only these feature ids (comma-separated)')
    ap.add_argument('-j', '--jobs', type=int, default=os.cpu_count() or 4, help='probes run at once')
    ap.add_argument('--probes', action='store_true', help='check: also check statuses against probes.tsv')
    args = ap.parse_args()
    globals()['cmd_' + args.command](args)


if __name__ == '__main__':
    main()
