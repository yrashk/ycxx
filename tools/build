#!/bin/sh
# Configure (on first use) and build ycxx, then run the bootstrap smoke test (tests/bootstrap).
# tools/test's `build` stage and CI call this. The binary is build/bin/ycxx.
#
#   tools/build [-j N] [--no-smoke]
#
# Environment: YCXX_BUILD_DIR (default build), YCXX_BUILD_TYPE (default Debug), and anything
# libycxx's toolchain file reads (YCXX_TOOLCHAINS; docs/BUILDING.md). A build directory
# configured earlier is reused as it is. Submodules are first moved to their pinned commits
# (tools/sync-submodules).
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
dir=${YCXX_BUILD_DIR:-$root/build}
jobs=
smoke=1
while [ $# -gt 0 ]; do
  case $1 in
    -j) jobs=$2; shift ;;
    -j*) jobs=${1#-j} ;;
    --no-smoke) smoke=0 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "build: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done

"$root/tools/sync-submodules"
if [ ! -f "$dir/build.ninja" ]; then
  cmake -S "$root" -B "$dir" -G Ninja -DCMAKE_BUILD_TYPE="${YCXX_BUILD_TYPE:-Debug}"
fi
cmake --build "$dir" ${jobs:+-j "$jobs"}
if [ "$smoke" = 1 ]; then
  ctest --test-dir "$dir" --output-on-failure ${jobs:+-j "$jobs"}
fi
