#!/bin/sh
# Configure (on first use) and build ycxx, then run the bootstrap smoke test (tests/bootstrap).
# tools/test's `build` stage and CI call this. The binary is build/bin/ycxx.
#
#   tools/build [-j N] [--no-smoke] [--no-tests]
#
# --no-tests builds only the compiler (build/bin/ycxx): no unit or daemon test binaries, and no
# smoke test. tools/test needs the full build.
#
# Environment: YCXX_BUILD_DIR (default build; relative to the repository), YCXX_BUILD_TYPE
# (default Debug, read when the directory is first configured), and anything
# libycxx's toolchain file reads (YCXX_TOOLCHAINS; docs/BUILDING.md). A build directory
# configured earlier is reused as it is. Submodules are first moved to their pinned commits
# (tools/sync-submodules).
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
dir=${YCXX_BUILD_DIR:-build}
case $dir in /*) ;; *) dir=$root/$dir ;; esac  # relative to the repository, as tools/test
jobs=
smoke=1
target=
while [ $# -gt 0 ]; do
  case $1 in
    -j) jobs=$2; shift ;;
    -j*) jobs=${1#-j} ;;
    --no-smoke) smoke=0 ;;
    --no-tests) smoke=0; target=ycxxc ;;
    -h|--help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "build: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done

"$root/tools/sync-submodules"
if [ ! -f "$dir/build.ninja" ]; then
  cmake -S "$root" -B "$dir" -G Ninja -DCMAKE_BUILD_TYPE="${YCXX_BUILD_TYPE:-Debug}"
fi
cmake --build "$dir" ${jobs:+-j "$jobs"} ${target:+--target "$target"}
if [ "$smoke" = 1 ]; then
  # CMake records the effective setting, which a normal variable can override.
  if ! grep -Fxq 1 "$dir/ycxx-ctests-enabled" 2>/dev/null; then
    echo "build: Enable CTests in $dir before running them. Reconfigure with -DYCXXC_BUILD_TESTS=ON and check any project override." >&2
    exit 1
  fi
  ctest --test-dir "$dir" --no-tests=error --output-on-failure ${jobs:+-j "$jobs"}
fi
