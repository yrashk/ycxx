SECTION = re.compile(r'\\rSec(\d)\[([^\]]+)\]')
BEGIN = re.compile(r'\\begin\{(example|codeblock|codeblocktu)\}(\{[^}]*\})?')


def examples(source):
    out = []
    for name in CORE:
        path = source / 'source' / f'{name}.tex'
        lines = path.read_text(encoding='utf-8').splitlines(keepends=True)
        clause = chapter = None
        counts, pnum, ex, block, depth = {}, 0, None, None, 0
        for n, line in enumerate(lines, 1):
            if block is not None:
                if re.match(r'\s*\\end\{' + block[0] + r'\}', line):
                    if ex is not None:
                        ex.blocks.append(block)
                    block = None
                else:
                    block[2].append(line)
                continue
            m = SECTION.search(line)
            if m:
                clause, pnum = m[2], 0
                if m[1] == '0':
                    chapter = clause
                continue
            pnum += len(re.findall(r'\\pnum\b', line))
            for m in BEGIN.finditer(line):
                if m[1] == 'example':
                    depth += 1
                    if depth == 1:
                        counts[clause] = counts.get(clause, 0) + 1
                        ex = Example(clause, chapter, counts[clause], pnum, f'source/{name}.tex', n)
                else:
                    block = (m[1], (m[2] or '')[1:-1], [])
            if re.search(r'\\end\{example\}', line):
                depth -= 1
                if depth == 0 and ex is not None:
                    ex.build()
                    out.append(ex)
                    ex = None
    return out


# --- oracles ----------------------------------------------------------------------------------

def body_hash(text):
    return hashlib.sha256(text.encode()).hexdigest()[:16]


def run_oracle(c, text, flags=()):
    """(exit status, [(line, message)] of errors in the example itself, [messages elsewhere])."""
    with tempfile.TemporaryDirectory() as d:
        src = Path(d) / 'example.cpp'
        src.write_text(text)
        try:
            p = subprocess.run(c.syntax(str(src), flags), capture_output=True, text=True, timeout=120, cwd=d)
        except subprocess.TimeoutExpired:
            return 'timeout', [], []
        here, elsewhere = [], []
        home = os.path.expanduser('~')
        clean = lambda m: m.replace(d, '.').replace(home, '~')  # no machine paths in oracles.tsv
        for m in re.finditer(r'^(?P<file>[^:\n]+):(?P<line>\d+):(?P<col>\d+): (?:fatal )?error: (?P<msg>.*)$',
                             p.stdout + p.stderr, re.M):
            if os.path.realpath(Path(d) / m['file']) == os.path.realpath(src):
                here.append((int(m['line']), clean(m['msg'].strip())))
            else:
                elsewhere.append(clean(m['msg'].strip()))
        return p.returncode, here, elsewhere


def read_oracles():
    rec = {}
    if ORACLES.is_file():
        for line in ORACLES.read_text().splitlines()[1:]:
            ident, h, comp, status, errs = (line.split('\t') + [''] * 5)[:5]
            lines = []
            for e in filter(None, errs.split(' ;; ')):
                ln, _, msg = e.partition(': ')
                lines.append((int(ln), msg))
            rec[(ident, comp)] = (h, status, lines)
    return rec


def write_oracles(rec, versions):
    rows = ['id\tbody-sha256\tcompiler\texit\terrors (line: message ;; ...)']
    for (ident, comp), (h, status, lines) in sorted(rec.items()):
        errs = ' ;; '.join(f'{ln}: {msg.replace(chr(9), " ")}' for ln, msg in lines)
        rows.append(f'{ident}\t{h}\t{comp}\t{status}\t{errs}')
    ORACLES.write_text('\n'.join(rows) + '\n')
    (OUT / 'oracle-versions.txt').write_text(''.join(f'{k}: {v}\n' for k, v in sorted(versions.items())))


# Errors an incomplete example produces: a name it uses but never declares, statements or
# expressions where declarations belong, a header it leaves out.
FRAGMENT = re.compile(
    r"undeclared identifier|was not declared|has not been declared|unknown type name|"
    r"does not name a type|expected unqualified-id|no template named|is not a template|"
    r"expected '[;)]' (?:after|before) top level declarator|expected constructor, destructor|"
    r"a type specifier is required|C\+\+ requires a type specifier|no member named .* in namespace 'std'|"
    r"is not a member of 'std'|expected declaration|explicit type is missing|"
    r"use of undeclared|unknown template name|not declared in this scope|"
    r"incomplete type '(?:std::)?initializer_list|was not declared in this scope|"
    r"expected primary-expression before|expected expression|expected initializer before|"
    r"'main' must return 'int'|has initializer but incomplete type|redefinition of 'main'|"
    r"outside of a function|expected unqualified-id before '(?:if|while|for|do|switch|return|try|goto)'|"
    r"does not name a template type|in namespace 'std' does not name|no member named .* in namespace 'std'|"
    r"file not found|No such file or directory|no include path|cannot be imported|include <typeinfo>|"
    r"include <new>|before using 'typeid'|include <initializer_list>|module '\w+' not found")
# Errors a statement at namespace scope produces; they count on lines the draft marks OK too.
TOPLEVEL = re.compile(
    r"a type specifier is required for all declarations|outside of a function|expected unqualified-id|"
    r"expected constructor, destructor, or type conversion|does not name a type|"
    r"C\+\+ requires a type specifier")
# A simple built-in declaration with an absent initializer. An inline block comment may stand in for the
# expression, but the same syntax diagnostics on `int i = ;` do not identify a draft placeholder.
INITIALIZER_GAP = re.compile(
    r'\s*(?:(?:const|volatile|constexpr|mutable)\s+)*'
    r'(?:(?:auto|bool|char|char(?:8|16|32)_t|wchar_t|short|int|long|signed|unsigned|float|double)\s+)+'
    r'[A-Za-z_]\w*\s*=\s*'
    r'(?:/\*(?P<comment>(?:(?!\*/).)*)\*/\s*)?;\s*')
INITIALIZER_ERROR = re.compile(
    r"expected (?:expression|primary-expression (?:at end of input|before ';' token))")


def verdict(ex, status, lines):
    """How an oracle's result compares with the draft: 'agree', or a short description."""
    if status == 'timeout':
        return 'timed out'
    if status not in (0, 1):
        return f'crashed (exit {status})'
    expected = ex.marked('error')
    got = {n for n, _ in lines}
    if status == 1 and not lines:
        return 'rejects with no located error'
    if not expected and not got:
        return 'agree'
    if expected and not got:
        return 'accepts'
    missing, extra = sorted(expected - got), sorted(got - expected)
    if not missing and not extra:
        return 'agree'
    parts = []
    if missing:
        parts.append('no error at line ' + ', '.join(map(str, missing)))
    if extra:
        parts.append('error at unannotated line ' + ', '.join(map(str, extra)))
    return ('rejects: ' if not expected else '') + '; '.join(parts)


def is_fragment(ex, results):
    """Both oracles report, on lines the draft does not annotate, an error of the kind an
    incomplete example produces. On a line the draft marks OK only the errors of a statement at
    namespace scope count; any other error there is a disagreement."""
    errors = ex.marked('error')
    marked = errors | ex.marked('ok')
    gaps = {}
    for n, (code, _, _) in enumerate(ex.lines, len(ex.prelude()) + 1):
        if gap := INITIALIZER_GAP.fullmatch(code):
            gaps[n] = bool((gap['comment'] or '').strip())
    first = []
    placeholder_errors = []
    for status, lines in results:
        hits = [(n, m) for n, m in lines
                if not (n in gaps and INITIALIZER_ERROR.fullmatch(m))
                and ((n not in marked and FRAGMENT.search(m)) or (n not in errors and TOPLEVEL.search(m)))]
        if hits:
            first.append(hits[0])
        if status == 1 and len(lines) == 1:
            n, m = lines[0]
            if n not in marked and gaps.get(n) and INITIALIZER_ERROR.fullmatch(m):
                placeholder_errors.append((n, m))
    if len(first) == 2:
        n, m = first[0]
    elif len(placeholder_errors) == 2 and placeholder_errors[0][0] == placeholder_errors[1][0]:
        n, m = placeholder_errors[0]
    else:
        return None
    return f'fragment: both oracles report errors an incomplete example produces (line {n}: {m})'


