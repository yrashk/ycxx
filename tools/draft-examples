def commit_date(repo, sha):
    try:
        p = subprocess.run(['gh', 'api', f'repos/{repo}/commits/{sha}', '--jq', '.commit.committer.date'],
                           capture_output=True, text=True, timeout=60)
        return p.stdout.strip()[:10]
    except OSError:
        return ''


def fetch(repo, sha, members):
    """The directory holding `members` (path prefixes inside the repository) at commit sha."""
    dest = CACHE / f'{repo.replace("/", "-")}-{sha}'
    if (dest / '.complete').exists():
        return dest
    shutil.rmtree(dest, ignore_errors=True)
    url = f'https://codeload.github.com/{repo}/tar.gz/{sha}'
    print(f'downloading {url}', file=sys.stderr)
    with urllib.request.urlopen(url) as r:
        data = r.read()
    with tarfile.open(fileobj=io.BytesIO(data), mode='r:gz') as tar:
        for m in tar.getmembers():
            rel = m.name.split('/', 1)[1] if '/' in m.name else ''
            if m.isfile() and any(rel.startswith(p) for p in members):
                out = dest / rel
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_bytes(tar.extractfile(m).read())
    (dest / '.complete').write_text(sha + '\n')
    return dest


# --- LaTeX ------------------------------------------------------------------------------------

def braced(s, i):
    """(content, end) of the {group} starting at s[i] == '{'."""
    depth = 0
    for j in range(i, len(s)):
        if s[j] == '{':
            depth += 1
        elif s[j] == '}':
            depth -= 1
            if depth == 0:
                return s[i + 1:j], j + 1
    return s[i + 1:], len(s)


# Commands that print their argument as it is, and those that print something fixed.
KEEP = {'tcode', 'textit', 'textrm', 'textnormal', 'rlap', 'emph', 'term', 'defn', 'grammarterm',
        'placeholder', 'placeholdernc', 'exposid', 'exposidnc', 'cvqual', 'libconcept', 'keyword',
        'terminal', 'textsc', 'texttt', 'textbf', 'tref', 'indextext', 'mathit', 'mathrm', 'text',
        'textsmaller', 'opt', 'uname', 'ucode', 'exposconcept', 'libglobal', 'libmember', 'oldconcept',
        'deflibconcept', 'impldef', 'unspec', 'range', 'xname', 'fakegrammarterm', 'textup', 'mbox'}
FIXED = {'commentellip': '/* ... */', 'caret': '^', 'atsign': '@', 'textbackslash': '\\', 'Cpp': 'C++',
         'ldots': '...', 'dotsc': '...', 'cdots': '...', 'vdots': '...', 'dots': '...', 'unun': '__',
         'ungap': '', 'colcol': '::', 'shl': '<<', 'shr': '>>', 'tilde': '~', 'textasciitilde': '~',
         'brk': '', 'unspecnc': 'unspecified', 'cv': 'cv', 'ell': 'l', 'times': 'x', 'leq': '<=',
         'geq': '>=', 'neq': '!=', 'rightarrow': '->', 'to': '->', 'cdot': '*', 'prime': "'",
         'textunderscore': '_', 'linebreak': '', 'newline': ' ', 'hfill': '', 'quad': ' ', 'mathtt': ''}
DROP = {'iref', 'ref', 'indexlibrary', 'index', 'indextext', 'footnote', 'label', 'indexdefn',
        'indexgrammar', 'indexlibraryglobal', 'indexlibrarymember', 'idxcode'}
# Notation that is not C++ when it appears in code: placeholders, cv-qualifier variables,
# grammar terms, optional parts, math.
META = {'placeholder', 'placeholdernc', 'cvqual', 'grammarterm', 'opt', 'exposid', 'exposidnc',
        'vdots', 'textrm', 'rlap', 'textit', 'mathit', 'dots', 'ldots', 'cdots', 'dotsc', 'unspec',
        'impldef', 'term', 'defn', 'tref', 'fakegrammarterm', 'ucode', 'uname'}


def delatex(s, meta=None):
    """Plain text of a LaTeX fragment. Commands found in META are added to `meta`."""
    out, i = [], 0
    while i < len(s):
        c = s[i]
        if c == '\\':
            m = re.match(r'\\([A-Za-z]+)\*?|\\(.)', s[i:])
            name, sym = m[1], m[2]
            i += len(m[0])
            if sym is not None:
                out.append({'\\': ' ', ',': ' ', ' ': ' ', '-': ''}.get(sym, sym))
                continue
            if meta is not None and name in META:
                meta.add(name)
            args = []
            while i < len(s) and s[i] == '{' and (len(args) < 1 or name in ('mname', 'unicode', 'libconceptx')):
                a, i = braced(s, i)
                args.append(a)
            if name == 'mname' and args:
                out.append('__' + delatex(args[0], meta) + '__')
            elif name == 'reflexpr' and args:
                out.append('^^' + delatex(args[0], meta))
            elif name == 'unicode' and len(args) == 2:
                out.append(f'U+{args[0]} {args[1]}')
            elif name in DROP:
                pass
            elif name in FIXED:
                out.append(FIXED[name])
            elif args:
                if name not in KEEP and meta is not None:
                    meta.add(name)
                out.append(delatex(args[-1], meta))
            elif meta is not None:
                meta.add(name)
        elif c == '$':
            j = s.find('$', i + 1)
            j = len(s) if j < 0 else j
            if meta is not None:
                meta.add('math')
            out.append(re.sub(r'[_^]', '', delatex(s[i + 1:j], meta)).replace('{', '').replace('}', ''))
            i = j + 1
        elif c in '{}':
            i += 1
        elif c == '~':
            out.append(' ')
            i += 1
        else:
            out.append(c)
            i += 1
    return ''.join(out)


def split_comment(line):
    """(code, comment) of a code-block line: the comment is what follows `//` outside string and
    character literals and outside @escapes@, still in LaTeX (listings' texcl)."""
    i, quote, esc = 0, None, False
    while i < len(line):
        c = line[i]
        if esc:
            if c == '@':
                esc = False
        elif quote:
            if c == '\\':
                i += 1
            elif c == quote:
                quote = None
        elif c == '@':
            esc = True
        elif c in '"\'' and not (c == "'" and i and line[i - 1].isalnum() and i + 1 < len(line) and line[i + 1].isalnum()):
            quote = c
        elif line.startswith('//', i):
            return line[:i], line[i + 2:]
        i += 1
    return line, None


def code_text(code, meta):
    """Code with its @escapes@ expanded."""
    parts = code.split('@')
    return ''.join(p if k % 2 == 0 else delatex(p, meta) for k, p in enumerate(parts))


def annotation(comment):
    """'error', 'ndr', 'ok' or None for a comment's leading words."""
    c = delatex(comment).strip().lower()
    c = re.sub(r'^(#\d+[a-z]?[,:;.]?\s*)+', '', c)
    if (re.match(r"(error|syntax error|ill-formed|ambiguous|access error|is ambiguous|can't convert|invalid array)\b", c)
            or re.search(r'\(ill-formed|(program|call) is ill-formed', c)):
        return 'ndr' if re.search(r'no diagnostic (is )?required', c) else 'error'
    if re.match(r'ok\b', c):
        return 'ok'
    return None


class Example:
    def __init__(self, clause, chapter, index, pnum, src, line):
        self.clause, self.chapter, self.index, self.pnum = clause, chapter, index, pnum
        self.src, self.line = src, line
        self.blocks = []   # (kind, title, [raw lines])
        self.lines = []    # [(code text, comment text or None, annotation)]
        self.skip = ''
        self.meta = set()

    @property
    def id(self):
        return f'{self.clause}-{self.index}'

    def marked(self, ann):
        """The body's line numbers annotated `ann`."""
        k = len(self.prelude())
        return {k + n for n, (_, _, a) in enumerate(self.lines, 1) if a == ann}

    @property
    def kind(self):
        return 'reject' if any(a == 'error' for _, _, a in self.lines) else 'accept'

    def prelude(self):
        """#include lines for the standard library names the example uses without including
        their header: the draft's examples take them for granted."""
        text = '\n'.join(code for code, _, _ in self.lines)
        have = set(re.findall(r'#\s*include\s*<([^>]+)>', text))
        need = {STD_HEADERS[n] for n in re.findall(r'\bstd::(\w+)', text) if n in STD_HEADERS}
        if re.search(r'\bauto\b[^;(]*=\s*\{|\bauto\b\s*\w+\s*\{[^}]*,', text):
            need.add('initializer_list')  # [dcl.type.auto.deduct]: deduces std::initializer_list
        if re.search(r'\btypeid\b', text):
            need.add('typeinfo')
        if re.search(r'\bnew\s*\(|operator\s+new|operator\s+delete', text):
            need.add('new')
        need = sorted(need - have)
        return [f'#include <{h}> // added by tools/draft-examples' for h in need]

    def flags(self):
        """Flags the oracles need for this example (FLAGS:): GCC 16 parses reflection only with
        -freflection; Clang 23 ignores it and has no reflection."""
        text = '\n'.join(code for code, _, _ in self.lines)
        return ['-freflection'] if re.search(r'\^\^|\[:|std::meta\b|<meta>', text) else []

    def body(self):
        """The test's source, one line per code-block line, with `//!` error markers."""
        out = self.prelude()
        for code, comment, ann in self.lines:
            if comment is None:
                out.append(code.rstrip())
            else:
                text = ' '.join(delatex(comment).split())
                if ann == 'error':  # the driver's marker is `//! error` (docs/TESTING.md)
                    text = '! ' + (text if text.startswith('error') else 'error: ' + text)
                out.append(f'{code}//{"" if ann == "error" else " "}{text}'.rstrip())
        return '\n'.join(out) + '\n'

    def build(self):
        tus = [b for b in self.blocks if b[0] == 'codeblocktu']
        if not self.blocks:
            self.skip = 'no code: the example is prose'
            return
        if tus:
            self.skip = f'{len(tus)} translation unit(s) (codeblocktu): needs a multi-unit test'
            return
        for n, (_, _, raw) in enumerate(self.blocks):
            if n:
                self.lines.append(('', None, None))
            for line in raw:
                code, comment = split_comment(line.rstrip('\n'))
                text = code_text(code, self.meta)
                self.lines.append((text, comment, annotation(comment) if comment is not None else None))
        if self.meta:
            self.skip = 'not C++: uses draft notation (' + ', '.join(sorted(self.meta)) + ')'
        elif any(a == 'ndr' for _, _, a in self.lines):
            self.skip = 'ill-formed, no diagnostic required: no verdict to test'
        elif any(a == 'error' and not code.strip() for code, _, a in self.lines):
            self.skip = 'an error annotation on a line without code'
        elif any(c is not None and re.match(r'\s*(translation unit|tu)\s*#?\d', delatex(c), re.I)
                 for _, c, _ in self.lines):
            self.skip = 'several translation units in one code block: needs a multi-unit test'
        elif re.search(r'#\s*include\s*"', self.body()):
            self.skip = 'includes a file the example does not provide'


