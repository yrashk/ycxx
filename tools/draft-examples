def cwg_issues(cwg):
    text = (cwg / 'issues' / 'cwg_toc.html').read_text(encoding='utf-8', errors='replace')
    out = []
    for row in re.findall(r'<TR>(.*?)</TR>', text, re.S):
        cells = re.findall(r'<TD[^>]*>(.*?)</TD>', row, re.S)
        if len(cells) != 4:
            continue
        num = re.sub(r'<[^>]+>', '', cells[0]).strip()
        if not num.isdigit():
            continue
        m = re.search(r'wg21\.link/([^"\s]+)"', cells[1])
        section = m[1] if m else re.sub(r'<[^>]+>', '', cells[1]).split()[-1:]
        section = section if isinstance(section, str) else (section[0] if section else '')
        status = re.sub(r'<[^>]+>', '', cells[2]).strip()
        title = ' '.join(html.unescape(re.sub(r'<[^>]+>', '', cells[3])).split())
        out.append((int(num), section, status, title))
    return sorted(out)


def draft_labels(source):
    """Every subclause's stable name in the pinned draft."""
    out = set()
    for f in (source / 'source').glob('*.tex'):
        out.update(m[2] for m in SECTION.finditer(f.read_text(encoding='utf-8', errors='replace')))
    return out


def write_cwg(issues, labels):
    """tests/draft/cwg-issues.tsv: each issue's subclause, status, whether it is resolved (its
    resolution is in a published standard or the working paper) and whether the pinned draft still
    has that subclause (issues name the stable name of their time)."""
    rows = ['issue\tsection\tstatus\tresolved\tsection-in-draft\ttitle']
    for num, section, status, title in issues:
        rows.append(f'{num}\t{section}\t{status}\t{"yes" if status in RESOLVED else "no"}\t'
                    f'{"yes" if section in labels else "no"}\t{title}')
    (OUT / 'cwg-issues.tsv').write_text('\n'.join(rows) + '\n')


# --- output -----------------------------------------------------------------------------------

def md_escape(s):
    return s.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('|', '\\|').replace('\n', ' ')


def generate(exs, rec, pins, issues, versions):
    for d in OUT.iterdir():
        if d.is_dir():
            shutil.rmtree(d)
    by_clause = {}
    for num, section, status, title in issues:
        by_clause.setdefault(section, []).append((num, status))
    index = ['id\tsubclause\tpnum\tsource\tresult\treason']
    rows, counts = [], {}
    for ex in exs:
        result, reason, xfails = 'skip', ex.skip, []
        if not ex.skip:
            text = ex.body()
            h = body_hash(text)
            results = {}
            for comp in ('clang', 'gcc'):
                r = rec.get((ex.id, comp))
                if r and r[0] == h:
                    results[comp] = (int(r[1]) if r[1].lstrip('-').isdigit() else r[1], r[2])
            if len(results) < 2:
                reason = 'no oracle verdicts recorded: rerun tools/draft-examples --oracles'
            else:
                frag = is_fragment(ex, results.values())
                if frag:
                    reason = frag
                else:
                    result, reason = ex.kind, ''
                    for comp, (status, lines) in results.items():
                        v = verdict(ex, status, lines)
                        if v != 'agree':
                            xfails.append((comp, v, lines))
            if result != 'skip':
                path = OUT / ex.chapter / f'{ex.id}.{result}.cpp'
                path.parent.mkdir(parents=True, exist_ok=True)
                head = [f'// [{ex.clause}]/{ex.pnum}, example {ex.index}: draft {ex.src}:{ex.line} '
                        f'at cplusplus/draft@{pins["draft"][:12]}.', GENERATED_BY]
                if ex.flags():
                    head.append('// FLAGS: ' + ' '.join(ex.flags()))
                for comp, v, _ in xfails:
                    head.append(f'// XFAIL: {comp} {v} (tests/draft/DISAGREEMENTS.md)')
                path.write_text('\n'.join(head) + '\n' + text)
                if xfails:
                    cw = by_clause.get(ex.clause, [])
                    rows.append((ex, {c: (v, ls) for c, v, ls in xfails}, cw))
        counts[result] = counts.get(result, 0) + 1
        index.append(f'{ex.id}\t{ex.clause}\t{ex.pnum}\t{ex.src}:{ex.line}\t{result}\t{reason}')
    (OUT / 'examples.tsv').write_text('\n'.join(index) + '\n')
    write_disagreements(rows, pins, versions)
    return counts


def write_disagreements(rows, pins, versions):
    def show(v):
        if not v:
            return 'agrees'
        what, lines = v
        first = '; '.join(f'{n}: {m}' for n, m in lines[:2])
        return md_escape((what + (f' — {first}' if first and what != 'accepts' else ''))[:300])

    def issues(cw):
        if not cw:
            return ''
        open_ = [n for n, s in cw if s not in RESOLVED]
        res = [n for n, s in cw if s in RESOLVED]
        parts = []
        if open_:
            parts.append('open: ' + ', '.join(f'[{n}](https://wg21.link/cwg{n})' for n in open_[-6:])
                         + (f' (+{len(open_) - 6})' if len(open_) > 6 else ''))
        if res:
            parts.append(f'{len(res)} resolved')
        return '; '.join(parts)

    both = sum(1 for _, d, _ in rows if len(d) == 2)
    out = [
        '# Draft examples the oracles disagree with',
        '',
        'Generated by `tools/draft-examples` from the oracle verdicts in `oracles.tsv`; do not edit.',
        f'Draft: cplusplus/draft@{pins["draft"][:12]}. CWG list: cplusplus/CWG@{pins["cwg"][:12]}.',
        'Oracles: ' + '; '.join(f'{k} = {v}' for k, v in sorted(versions.items())) + '.',
        '',
        'Each row is an extracted test (`tests/draft/<chapter>/<id>.*.cpp`) that Clang 23 or GCC 16',
        'gets wrong against the draft\'s annotation, with the locations compared by line as `tools/test`',
        'does. The test carries an `XFAIL` for that compiler, so `tools/test --cxx clang|gcc tests/draft`',
        'passes, and an XPASS shows when a compiler changes its mind. The CWG column lists the issues',
        'filed against the subclause (`cwg-issues.tsv`): an open one is often the cause, a resolved one',
        'can mean the example or the compiler predates the resolution. Triage notes go in the issue',
        'that fixes the test or the compiler, not here.',
        '',
        f'{len(rows)} tests; both oracles disagree on {both}.',
        '',
        '| test | draft | Clang 23 | GCC 16 | CWG issues on the subclause |',
        '|---|---|---|---|---|',
    ]
    for ex, d, cw in rows:
        out.append(f'| [{ex.id}]({ex.chapter}/{ex.id}.{ex.kind}.cpp) | {ex.kind} | {show(d.get("clang"))} '
                   f'| {show(d.get("gcc"))} | {issues(cw)} |')
    (OUT / 'DISAGREEMENTS.md').write_text('\n'.join(out) + '\n')


# --- main -------------------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(description=__doc__.split('\n\n')[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--oracles', action='store_true', help='run Clang and GCC on every example and record the verdicts')
    ap.add_argument('--pin-draft', metavar='SHA', help='pin this commit of cplusplus/draft')
    ap.add_argument('--pin-cwg', metavar='SHA', help='pin this commit of cplusplus/CWG (gh-pages)')
    ap.add_argument('-j', type=int, default=os.cpu_count() or 4)
    args = ap.parse_args()

    pins = read_pins() if PINS.is_file() else {}
    if args.pin_draft or args.pin_cwg:
        pins['draft'] = args.pin_draft or pins['draft']
        pins['cwg'] = args.pin_cwg or pins['cwg']
        write_pins(pins, {'draft': commit_date('cplusplus/draft', pins['draft']),
                          'cwg': commit_date('cplusplus/CWG', pins['cwg'])})
    draft = fetch('cplusplus/draft', pins['draft'], ['source/'])
    cwg = fetch('cplusplus/CWG', pins['cwg'], ['issues/cwg_toc.html'])

    exs = examples(draft)
    issues = cwg_issues(cwg)
    write_cwg(issues, draft_labels(draft))
    rec = read_oracles()
    versions = {}
    vf = OUT / 'oracle-versions.txt'
    if vf.is_file():
        for line in vf.read_text().splitlines():
            k, _, v = line.partition(': ')
            versions[k] = v
    if args.oracles:
        comps = toolchain.discover(REPO)
        for name in ('clang', 'gcc'):
            if not comps[name].available:
                sys.exit(f'tools/draft-examples: {name} not found ({comps[name].why_missing})')
            versions[name] = comps[name].version
        todo = [ex for ex in exs if not ex.skip]
        new = {}

        def one(job):
            ex, name = job
            text = ex.body()
            status, here, _ = run_oracle(comps[name], text, ex.flags())
            return (ex.id, name), (body_hash(text), str(status), here)

        jobs = [(ex, n) for ex in todo for n in ('clang', 'gcc')]
        with concurrent.futures.ThreadPoolExecutor(args.j) as pool:
            for k, (key, val) in enumerate(pool.map(one, jobs), 1):
                new[key] = val
                if k % 100 == 0:
                    print(f'oracles: {k}/{len(jobs)}', file=sys.stderr)
        rec = new
        write_oracles(rec, versions)
    counts = generate(exs, rec, pins, issues, versions)
    print(f'{len(exs)} examples: ' + ', '.join(f'{v} {k}' for k, v in sorted(counts.items())))


if __name__ == '__main__':
    main()
