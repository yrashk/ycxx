#!/bin/sh
# A ThreadSanitizer build of ycxx (#105; the nightly tier, DECISIONS §9.3): ycxx, the std modules
# and libycxx instrumented (YCXXC_SANITIZE=thread), in build-tsan; then the unit and daemon tests,
# and the concurrent ones again N times. Linux only: GCC has no ThreadSanitizer on macOS arm64
# (docs/LESSONS.md), and its GCC needs libtsan (libycxx's provision --with-sanitizers).
#
#   tools/tsan [-j N] [--repeat N]
#
# A report fails the test (halt_on_error). A false positive is suppressed with its reason in
# tests/tsan.supp; a race is fixed.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
dir=${YCXX_TSAN_BUILD_DIR:-$root/build-tsan}
jobs=
repeat=10
while [ $# -gt 0 ]; do
  case $1 in
    -j) jobs=$2; shift ;;
    -j*) jobs=${1#-j} ;;
    --repeat) repeat=$2; shift ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "tsan: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done

"$root/tools/sync-submodules"
# Configured every time (cheap when nothing changed), so a build directory configured otherwise
# never passes uninstrumented.
cmake -S "$root" -B "$dir" -G Ninja -DCMAKE_BUILD_TYPE=Debug -DYCXXC_SANITIZE=thread -DYCXXC_BOOTSTRAP_SMOKE=OFF
cmake --build "$dir" ${jobs:+-j "$jobs"}
TSAN_OPTIONS="halt_on_error=1 second_deadlock_stack=1 suppressions=$root/tests/tsan.supp${TSAN_OPTIONS:+ $TSAN_OPTIONS}"
export TSAN_OPTIONS
# The unit tests, and the daemon's, which drive the instrumented, multithreaded ycxxc.
ctest --test-dir "$dir" --output-on-failure ${jobs:+-j "$jobs"} -R '^(unit|daemon)\.'
# What runs threads or pools, again: the scheduler and the engine, the interners, the
# preprocessor's sessions, sema's records, the incremental pipeline and the daemon.
ctest --test-dir "$dir" --output-on-failure ${jobs:+-j "$jobs"} --repeat until-fail:"$repeat" \
  -R '^unit\.(engine|engine_.*|ast_concurrent|ast_fingerprints|pp|sema|pipeline_incremental|daemon)$'
